    "mode": "embedded",
    "release": "1.0.0",
    "budget": { "maxBundleBytes": 1048576, "maxFiles": 8 }
  },
  "genres": ["Puzzle", "Brain"],
  "tags": ["memory", "sequence", "reaction", "pattern", "short-session", "mobile", "single-player"],
  "controls": ["mouse", "touch", "keyboard"],
  "players": { "min": 1, "max": 1 },
  "support": { "desktop": "full", "mobile": "full" },
  "media": {
    "cover": null,
    "hero": null,
    "logo": null,
    "screenshots": []
  },
  "theme": { "accent": "#f0c15a", "background": "#080b10" },
  "credits": {
    "developer": "Rokumon Games",
    "art": "In-file SVG",
