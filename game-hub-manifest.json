{
  "slug": "rokumon-brain-trainer",
  "title": "Rokumon Brain Trainer",
  "tagline": "Six short drills. Pass the six gates each day.",
  "description": "Six short drills, one per gate of the Rokumon crest: sequence memory, reaction time, odd-one-out pattern, number count, quick sums and colour clash. Passing gates fills the daily crest and builds a streak. Personal bests and the streak are stored locally; scores and events are reported to the hub.",
  "status": "released",
  "visibility": "unlisted",
  "featured": false,
  "version": "1.1.0",
  "releasedAt": "2026-11-10",
  "updatedAt": "2026-11-12",
  "delivery": {
    "mode": "embedded",
    "release": "1.1.0",
    "budget": { "maxBundleBytes": 1048576, "maxFiles": 8 }
  },
  "genres": ["Puzzle", "Brain"],
  "tags": ["memory", "sequence", "reaction", "pattern", "arithmetic", "focus", "daily", "streak", "short-session", "mobile", "single-player"],
  "controls": ["mouse", "touch", "keyboard"],
  "players": { "min": 1, "max": 1 },
  "support": { "desktop": "full", "mobile": "full" },
  "media": {
    "cover": null,
    "hero": null,
    "logo": null,
    "screenshots": []
  },
  "theme": { "accent": "#f0c15a", "background": "#080b10" },
  "credits": {
    "developer": "Rokumon Games",
    "art": "In-file SVG",
    "audio": "Web Audio"
  },
  "runtime": {
    "kind": "iframe",
    "entry": "/games/rokumon-brain-trainer/index.html",
    "trust": "first-party",
    "orientation": "any",
    "allowFullscreen": true,
    "pointerLock": false
  },
  "bridge": {
    "version": 1,
    "enabled": true,
    "capabilities": ["ready", "score", "event", "gameOver"],
    "events": [
      { "name": "sequence-completed", "properties": { "level": "number" } },
      { "name": "reaction-completed", "properties": { "ms": "number" } },
      { "name": "reaction-best", "properties": { "ms": "number" } },
      { "name": "pattern-correct", "properties": { "round": "number" } },
      { "name": "count-completed", "properties": { "ms": "number" } },
      { "name": "sums-completed", "properties": { "correct": "number" } },
      { "name": "colour-completed", "properties": { "correct": "number" } },
      { "name": "gate-passed", "properties": { "gate": "number", "drill": "string", "today": "number" } },
      { "name": "crest-complete", "properties": { "streak": "number" } }
    ]
  },
  "source": {
    "repo": "https://github.com/SarutobiSasuke8/rokumon-brain-trainer",
    "localPath": null,
    "bundlePath": null,
    "bundleIncludes": ["index.html", "game-hub-manifest.json", "README.md"],
    "buildCommand": null
  }
}
