{
  "slug": "rokumon-brain-trainer",
  "title": "Rokumon Brain Trainer",
  "tagline": "Sequence, reaction and pattern drills.",
  "description": "Three short cognitive modes: sequence memory, reaction time and odd-one-out pattern. Personal bests stored locally, scores and events reported to the hub.",
  "status": "released",
